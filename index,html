  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <h2>Contact</h2>
    <p>Un stage, un projet, une question : écrivez-moi.</p>
    <a class="big" href="mailto:votre.email@exemple.com">votre.email@exemple.com</a>
